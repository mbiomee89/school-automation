# Server
PORT=3001
NODE_ENV=development

# Database — local SQLite (relative to prisma/schema.prisma)
DATABASE_URL="file:../dev.db"

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
PARENT_JWT_EXPIRES_IN=2h

# CORS allowlist (comma-separated HTTPS origins). Required when NODE_ENV=production.
# Example: CORS_ORIGIN=https://your-school-domain.com
# Uploads (server disk only — not publicly served)
UPLOAD_DIR=./backend/uploads
